#include <iostream>
using namespace std;
int main() {
    cout << "=================================================================" << endl;
    cout << "THIS IS FOR LOOPING" << endl;
    cout << " 'i' = ITERATOR / INDEX " << endl;
    cout << " Keeps track how many times the loop has run and which step your on " << endl;
    cout << " Increment Operator = i++ (Increase i by 1) ex. if i = 1, after i++ it becomes 2 " << endl;
    cout << " i+=2 → increase i by 2 each loop (1,3,5,7,9...)" << endl;
    cout << " i+=5 → increase i by 5 each loop (1,6...) " << endl;
    cout << "'++' is a shortcut for +1 only." << endl;
    cout << "=================================================================" << endl;
    cout << "BASICALLY" << endl;
    cout << "Iteration: Number of loops or when it will stop" << endl;
    cout << "Increment Operators: The number that will be skipped/the sequence" << endl;
    cout << "=================================================================" << endl;

    for (int i = 1; i <= 5; i++) {
        cout << i << " ";
    }
    cout << "=================================================================" << endl;
    cout << "SUM OF FIRST 10 INTEGERS" << endl;
    cout << "for= where the loop starts" << endl;
    cout << "int i = 1; = what number the loop will start " << endl;
    cout << "=================================================================" << endl;
    int sum = 0;
    for (int i = 1; i <= 10; i++) {
            sum += i;
    }
       cout <<  "sum = " << sum << endl;


    cout << "=================================================================" << endl;
    cout << "Multiplication table of 2" << endl;
    int number = 2;
    for (int i = 1; i <= 10; i++) {
        cout << number << " x " << i
        << " = " << number * i << endl;
    }

    cout << "=================================================================" << endl;
    cout << "WHILE loop" << endl;
    cout << "Countdown from 5" << endl;
    int i = 5;
    while (i > 0) {
        cout << i << " ";
        i--;
    }
    cout << "=================================================================" << endl;
    cout << "the increment is i-- means subtract " << endl;
    cout << "" << endl;

    cout << "ANOTHER WHILE LOOP" << endl;
    int num;
    cout << "Enter numbers (0 to stop): " << endl;
    cin >> num;
    while (num != 0) {
        cout << "You entered: " << num << endl;
        cin >> num;
    }
    cout << "" << endl;



    cout << "ANOTHER WHILE LOOP" << endl;
    int anotherNum, sumTotal = 0;
    cout << "Enter a positive number (-1 to stop): " << endl;
    cin >> anotherNum;
    while (anotherNum != -1) {
        sum += anotherNum;
        cin >> anotherNum;
    }
    cout << "Sum = " << sumTotal << endl;

    cout << "DO WHILE LOOP" << endl;
    int numforThis = 7, guess;
    do {
        cout << "Guess the number: " << endl;
        cin >> guess;
    } while (guess != numforThis);
    cout << "Correct!" << endl;


    cout << "ANOTHER DO WHILE LOOP" << endl;
    cout << "" << endl;
    int choice;
    do {
        cout << "1. Say Hello\n2. Exit\n" << endl;
        cout << "Enter Choice: " << endl;
        cin >> choice;
        if (choice == 1)
            cout << "Hello!\n" << endl;
    }     while (choice !=2);
    cout << "" << endl;


    cout << "NESTED LOOPS" << endl;
    for (int i = 1; i <= 3; i++) {
        for (int j = 1; j <= 3; j++) {
            cout << i << " x " << j
            << " = " << i * j << endl;
        }
    }



    cout << "" << endl;


    cout << "LOOPS WITHIN LOOPS" << endl;
    int matrix[2][3] = {{1, 2, 3}, {4, 5, 6}};
    // Outer loop → rows
    for (int i = 0; i < 2; i++) {
        // Inner loop → columns
        for (int j = 0; j < 3; j++) {
            cout << matrix[i][j] << " ";
        }
        cout << endl; // move to next line after each row
    }

    cout << "BREAK AND CONTINUE STATEMENTS" << endl;
    for (int i = 1; i <= 10; i++) {
        if (i == 5)
            break;              // stop the loop when i equals 5
        cout << i << " ";       // print i followed by a space
    }

    cout << "ANOTHER BREAK AND CONTINUE STATEMENTS" << endl;
    for (int i = 1; i <= 10; i++) {
        if (i == 5)
            continue;           // skip this loop when i equals 5
        cout << i << " ";       // print i followed by a space
    }






    cout << "" << endl;



    return 0;

}
